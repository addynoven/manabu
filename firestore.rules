rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth UID, must match userId
    //   - displayName: string (required, 1-100 chars) - Public user display name
    //   - totalXp: number (required, >= 0) - Total accumulated experience points
    //   - avatarEmoji: string (optional, <= 20 chars) - Avatar icon or emoji
    //   - photoURL: string (optional, <= 500 chars or null) - Profile picture URL
    //   - bio: string (optional, <= 500 chars) - Biography / study motto
    //   - beltRank: string (optional, <= 20 chars) - Martial belt rank tier
    //   - currentStreak: number (optional, >= 0) - Current daily study streak
    //   - bestStreak: number (optional, >= 0) - All-time best study streak
    //   - level: number (optional, >= 0) - Calculated player level
    //   - dailyGoalXp: number (optional, >= 0) - Daily target XP goal
    //   - todayXp: number (optional, >= 0) - XP gained on current date
    //   - todayDate: string (optional, <= 50 chars or null) - Current date tracking string
    //   - joinedDate: string (optional, <= 50 chars) - Account creation date
    //   - lastActiveDate: string (optional, <= 50 chars or null) - Last activity date
    //   - kanaPracticedCount: number (optional, >= 0) - Total kana characters practiced
    //   - kanjiPracticedCount: number (optional, >= 0) - Total kanji characters practiced
    //   - vocabPracticedCount: number (optional, >= 0) - Total vocabulary items practiced
    //   - totalQuestionsAnswered: number (optional, >= 0) - Total quiz questions attempted
    //   - totalCorrect: number (optional, >= 0) - Total correct quiz answers
    //   - createdAt: timestamp (optional, immutable) - Document creation timestamp
    //   - updatedAt: timestamp (optional) - Document modification timestamp
    //
    // Subcollection: users/{userId}/friends/{friendId}
    // Document ID: {friendId} (UID of friend)
    // Access: Authenticated users can read; owner only can write
    //
    // Collection: users/{userId}/private/{document=**}
    // Document ID: Any document path under the user's private subcollection tree
    // Purpose: Private user storage for study progress, mastery items, sync data, settings
    // Access: Authenticated owner-only read and write (request.auth.uid == userId)
    //
    // Collection: friend_requests/{requestId}
    // Document ID: {requestId}
    // Access:
    //   - Read: Authenticated participant (fromUid or toUid)
    //   - Create: Authenticated sender (request.auth.uid == request.resource.data.fromUid)
    //   - Update: Authenticated participant (fromUid or toUid)
    //
    // Collection: community_feed/{feedId}
    // Document ID: {feedId}
    // Access:
    //   - Read: Authenticated users
    //   - Create: Authenticated creator (request.auth.uid == request.resource.data.actorUid)
    //   - Update: Authenticated users (e.g. for incrementing likes)
    //
    // Default Deny:
    // Any document or collection not explicitly matched is denied.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the owner of the document path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate that immutable fields are not changed on update
    function areImmutableFieldsUnchanged() {
      return uidNotModified() &&
        (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validate public user profile schema for both create and update
    function isValidUser(userId) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'displayName', 'totalXp'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'totalXp',
          'avatarEmoji', 'photoURL', 'bio', 'beltRank',
          'currentStreak', 'bestStreak', 'level',
          'dailyGoalXp', 'todayXp', 'todayDate',
          'joinedDate', 'lastActiveDate',
          'kanaPracticedCount', 'kanjiPracticedCount', 'vocabPracticedCount',
          'totalQuestionsAnswered', 'totalCorrect',
          'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.totalXp is number
        && data.totalXp >= 0
        && (!('avatarEmoji' in data) || (data.avatarEmoji is string && data.avatarEmoji.size() <= 20))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('beltRank' in data) || (data.beltRank is string && data.beltRank.size() <= 20))
        && (!('currentStreak' in data) || (data.currentStreak is number && data.currentStreak >= 0))
        && (!('bestStreak' in data) || (data.bestStreak is number && data.bestStreak >= 0))
        && (!('level' in data) || (data.level is number && data.level >= 0))
        && (!('dailyGoalXp' in data) || (data.dailyGoalXp is number && data.dailyGoalXp >= 0))
        && (!('todayXp' in data) || (data.todayXp is number && data.todayXp >= 0))
        && (!('todayDate' in data) || data.todayDate == null || (data.todayDate is string && data.todayDate.size() <= 50))
        && (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 50))
        && (!('lastActiveDate' in data) || data.lastActiveDate == null || (data.lastActiveDate is string && data.lastActiveDate.size() <= 50))
        && (!('kanaPracticedCount' in data) || (data.kanaPracticedCount is number && data.kanaPracticedCount >= 0))
        && (!('kanjiPracticedCount' in data) || (data.kanjiPracticedCount is number && data.kanjiPracticedCount >= 0))
        && (!('vocabPracticedCount' in data) || (data.vocabPracticedCount is number && data.vocabPracticedCount >= 0))
        && (!('totalQuestionsAnswered' in data) || (data.totalQuestionsAnswered is number && data.totalQuestionsAnswered >= 0))
        && (!('totalCorrect' in data) || (data.totalCorrect is number && data.totalCorrect >= 0))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public User Document: users/{userId}
    match /users/{userId} {
      // Authenticated users can read public study profiles (leaderboards, member search)
      allow read: if isAuthenticated();

      // Only the authenticated owner can create their user profile document
      allow create: if isOwner(userId) && isValidUser(userId);

      // Only the authenticated owner can update their user profile document
      allow update: if isOwner(userId)
                    && isValidUser(userId)
                    && areImmutableFieldsUnchanged();

      // Only the authenticated owner can delete their user profile document
      allow delete: if isOwner(userId);

      // Subcollection: users/{userId}/friends/{friendId}
      match /friends/{friendId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Private User Subcollections: users/{userId}/private/{document=**}
      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Friend Requests Collection: friend_requests/{requestId}
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.fromUid;
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
    }

    // Community Feed Collection: community_feed/{feedId}
    match /community_feed/{feedId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.actorUid;
      allow update: if isAuthenticated();
    }

    // Explicit default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
