rules_version = '2';

// MANABU V3 DRAFT. NOT yet run through the Firebase emulator.
// Replaces: public users/{uid}, users/{uid}/friends, community_feed.
// Mirrors src/features/community/models/social.model.ts - keep the two in sync.
// Design: friends-only. No global list queries on profiles. Rules-only (no Cloud Functions).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/profiles/$(uid);
    }
    function requestPath(id) {
      return /databases/$(database)/documents/friend_requests/$(id);
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
          || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }

    // Pure sanity bound against absurd values. Rain, Catch and Survival run until lives/timer run out,
    // so they have no real maximum, and a tight cap would reject legitimate long runs.
    function maxScore(game) {
      return {'rain': 1000000, 'snake': 1000000, 'catch': 1000000, 'survival': 1000000}[game];
    }

    // ---------- private data (owner only) ----------
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /private/{docId} {
        allow read, write: if isOwner(uid);   // full backup snapshot; watch the 1 MiB document limit
      }
    }

    // ---------- public profile (get only, never list) ----------
    function validDaily(d) {
      return d is map
        && d.keys().hasAll(['date', 'score', 'timeSeconds', 'accuracy'])
        && d.keys().hasOnly(['date', 'score', 'timeSeconds', 'accuracy'])
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.score is number && d.score >= 0 && d.score <= 1000000
        && d.timeSeconds is number && d.timeSeconds >= 0 && d.timeSeconds <= 86400
        && d.accuracy is number && d.accuracy >= 0 && d.accuracy <= 100;
    }

    function validProfile(p) {
      return p.keys().hasAll(['uid', 'displayName', 'avatarEmoji', 'beltRank', 'level', 'totalXp',
                              'weeklyXp', 'weekId', 'currentStreak', 'friendCode', 'lastActiveDate', 'updatedAt'])
        && p.keys().hasOnly(['uid', 'displayName', 'avatarEmoji', 'beltRank', 'level', 'totalXp',
                             'weeklyXp', 'weekId', 'currentStreak', 'friendCode', 'lastActiveDate', 'daily', 'updatedAt'])
        && p.displayName is string && p.displayName.size() >= 1 && p.displayName.size() <= 24
        && p.avatarEmoji is string && p.avatarEmoji.size() <= 16
        && p.beltRank is string && p.beltRank.size() <= 16
        && p.level is int && p.level >= 1 && p.level <= 200
        && p.totalXp is int && p.totalXp >= 0 && p.totalXp <= 100000000
        && p.weeklyXp is int && p.weeklyXp >= 0 && p.weeklyXp <= p.totalXp
        && p.weekId is string && p.weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && p.currentStreak is int && p.currentStreak >= 0 && p.currentStreak <= 20000
        && p.friendCode is string && p.friendCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && (p.lastActiveDate == null
            || (p.lastActiveDate is string && p.lastActiveDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && p.updatedAt == request.time
        && (!('daily' in p) || validDaily(p.daily));
    }

    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;   // no enumeration of users

      // Initial XP cannot be verified (offline play before first sync). Acceptable for friends-only.
      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.uid == uid;

      // Sanity bound only: limits how fast XP can RISE. Stops absurd values, not a determined cheater.
      // XP may drop, because the app has a "Reset All Progress" button.
      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.friendCode == resource.data.friendCode
        && request.resource.data.totalXp - resource.data.totalXp
             <= 3000 + ((request.time.toMillis() - resource.data.updatedAt.toMillis()) / 1000) * 20;

      allow delete: if isOwner(uid);
    }

    // ---------- friend codes: lookup by get, no list ----------
    // Client must create /profiles/{uid} and /friend_codes/{code} in ONE batch (getAfter checks the profile).
    match /friend_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profilePath(request.auth.uid)).data.friendCode == code;
      allow update, delete: if false;
    }

    // ---------- friend requests: doc id = fromUid_toUid ----------
    match /friend_requests/{reqId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && reqId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(profilePath(request.resource.data.toUid));

      // Only the recipient answers, and only the status changes.
      allow update: if isOwner(resource.data.toUid)
        && resource.data.status == 'pending'
        && changedOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      // Either side can cancel/clear. Re-sending after a decline = delete, then create.
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ---------- friendships: doc id = fromUid_toUid of the accepted request ----------
    // Client accepts with ONE batch: update request.status -> 'accepted' AND create the friendship.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.members.size() == 2
        && request.resource.data.members[1] == request.auth.uid           // recipient creates it
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && get(requestPath(id)).data.status == 'pending'
        && get(requestPath(id)).data.fromUid == request.resource.data.members[0]
        && get(requestPath(id)).data.toUid == request.auth.uid
        && getAfter(requestPath(id)).data.status == 'accepted'
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- async score challenges: doc id = creatorUid_targetUid_gameId ----------
    // members = [creatorUid, targetUid]. No names/photos stored: read them from profiles.
    // No XP reward for winning (two-account farming); use a local badge instead.
    match /arcade_challenges/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'mode', 'creatorUid', 'targetUid', 'members',
             'creatorScore', 'targetScore', 'winnerUid', 'status', 'createdAt', 'expiresAt'])
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.members == [request.auth.uid, request.resource.data.targetUid]
        && id == request.auth.uid + '_' + request.resource.data.targetUid + '_' + request.resource.data.gameId
        && request.resource.data.mode is string && request.resource.data.mode.size() <= 24
        && request.resource.data.creatorScore is int
        && request.resource.data.creatorScore >= 0
        && request.resource.data.creatorScore <= maxScore(request.resource.data.gameId)
        && request.resource.data.targetScore == null
        && request.resource.data.winnerUid == null
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt == request.time + duration.value(48, 'h')
        && areFriends(request.auth.uid, request.resource.data.targetUid);

      // Only the target, only while pending and unexpired, only the result fields.
      allow update: if signedIn()
        && request.auth.uid == resource.data.targetUid
        && resource.data.status == 'pending'
        && request.time < resource.data.expiresAt
        && changedOnly(['targetScore', 'winnerUid', 'status'])
        && (
          (request.resource.data.status == 'declined'
            && request.resource.data.targetScore == null
            && request.resource.data.winnerUid == null)
          ||
          (request.resource.data.status == 'completed'
            && request.resource.data.targetScore is int
            && request.resource.data.targetScore >= 0
            && request.resource.data.targetScore <= maxScore(resource.data.gameId)
            && request.resource.data.winnerUid ==
                 (request.resource.data.targetScore > resource.data.creatorScore ? resource.data.targetUid
                  : (request.resource.data.targetScore < resource.data.creatorScore ? resource.data.creatorUid : 'tie')))
        );

      // Creator can cancel anytime; either side can clear a finished challenge (rematch = delete + create).
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.creatorUid
            || (request.auth.uid in resource.data.members && resource.data.status != 'pending'));
    }
  }
}
